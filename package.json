{
  "name": "boilerplate",
  "version": "1.0.0",
  "description": "boilerplate",
  "main": "index.js",
  "scripts": {
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "start": "env DEBUG=provider:* node ./src/index.js",
    "dev": "nodemon --trace-warnings --exec 'env DEBUG=provider:* node' ./src/index.js"
  },
  "author": "Mehmood Hussain",
  "license": "MIT",
  "dependencies": {
    "async-redis": "^2.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "joi-password-complexity": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
